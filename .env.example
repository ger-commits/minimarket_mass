# Copia este archivo como .env y completa tus datos (el .env NO se sube a GitHub)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minimarket_mass
DB_USER=root
DB_PASS=

# Caja fija de esta PC (número de la tabla caja)
CAJA_ID=1

# Escáner de celular del cajero (opcional)
# ESCANER_MODO=usb        usb = cable USB (conectar_celular_usb.bat), wifi = Wi-Fi
# ESCANER_PUERTO=         puerto que mostrará el QR, solo si el celular usa otro puerto
# ESCANER_URL_BASE=       dirección completa, solo si hace falta forzarla

# Escáner del ALMACÉN por celular SIN cable (dirección https pública de la carpeta public/, p. ej. un túnel fijo).
# Es independiente del escáner de caja (ESCANER_*). Si la dejas vacía, la pegas en el formulario «Conectar celular».
# ALMACEN_ESCANER_URL_BASE=https://almacen.tudominio.com
# Solo si publicas TODO el sistema en un dominio real (desactiva el bloqueo de rutas por dirección pública):
# ACCESO_PUBLICO_COMPLETO=1
